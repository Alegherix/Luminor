{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "LUMINOR_HOME",
    "LUMINOR_DESKTOP_WS_URL",
    "LUMINOR_BROWSER_HOST_PIPE_PATH",
    "LUMINOR_BROWSER_USE_PIPE_PATH",
    "LUMINOR_BROWSER_PERF",
    "LUMINOR_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "LUMINOR_GROK_ACP_DEBUG",
    "LUMINOR_WEB_SOURCEMAP",
    "LUMINOR_SERVER_SOURCEMAP",
    "LUMINOR_DESKTOP_SOURCEMAP",
    "LUMINOR_MODE",
    "LUMINOR_PORT",
    "LUMINOR_NO_BROWSER",
    "LUMINOR_AUTH_TOKEN",
    "LUMINOR_PUBLIC_URL",
    "LUMINOR_ALLOW_INSECURE_REMOTE",
    "LUMINOR_LOG_WS_EVENTS",
    "LUMINOR_HOST",
    "LUMINOR_DEV_SERVICE",
    "LUMINOR_DEV_SYSTEMD_UNIT",
    "LUMINOR_PORT_OFFSET",
    "LUMINOR_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
