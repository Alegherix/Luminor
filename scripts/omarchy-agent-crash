#!/usr/bin/env bash
# Route Omarchy crash notifications into Luminor Dev when it is already open.
# Same argv as the packaged command: <pid> [comm] [exe] [signal].
set -euo pipefail

PACKAGED="/usr/share/omarchy/bin/omarchy-agent-crash"
OPEN="${LUMINOR_DEV_OPEN:-$HOME/.local/bin/luminor-dev-open}"

pid=${1:?usage: omarchy-agent-crash <pid> [comm] [exe] [signal]}

if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Not a PID: $pid" >&2
  echo "Usage: omarchy agent crash <pid>   (see: coredumpctl list)" >&2
  exit 1
fi

comm=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

is_luminor_dev_up() {
  local cmd
  while IFS= read -r cmd; do
    case "$cmd" in
      *"--luminor-dev-root="*"dist-electron/main.js"*|*"dist-electron/main.js"*"--luminor-dev-root="*)
        return 0
        ;;
    esac
  done < <(ps -eo args= 2>/dev/null || true)
  return 1
}

fallback_packaged() {
  exec "$PACKAGED" "$@"
}

if ! is_luminor_dev_up; then
  fallback_packaged "$@"
fi

skill="$OMARCHY_PATH/default/agents/skills/diagnose-crash/SKILL.md"

when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

prompt=$(
  cat <<PROMPT
A process crashed on this Omarchy machine and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Use the diagnose-crash skill: it covers how to investigate, what to report, and
when a crash is worth reporting upstream to Omarchy. If your harness has no skill
mechanism, read the skill files directly and follow them instead:

  $skill
PROMPT
)

prompt_file=""
if ! prompt_file="$(mktemp --suffix=.md "${TMPDIR:-/tmp}/luminor-inbound-XXXXXX")"; then
  fallback_packaged "$@"
fi

cleanup_prompt() {
  if [[ -n "${prompt_file}" ]]; then
    rm -f "${prompt_file}"
  fi
}

if ! printf '%s\n' "$prompt" > "$prompt_file" || [[ ! -s "$prompt_file" ]]; then
  cleanup_prompt
  fallback_packaged "$@"
fi

if [[ ! -x "$OPEN" ]]; then
  cleanup_prompt
  fallback_packaged "$@"
fi

if ! "$OPEN" --new-chat --prompt-file "$prompt_file" --title "Process crashed: $comm" --folder Crashes --submit; then
  cleanup_prompt
  fallback_packaged "$@"
fi

exit 0
